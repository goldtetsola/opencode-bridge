# Optional vLLM backend for the OSS Agent Runtime.
#
# This file is an evaluation starting point, not a default production mode.
# Serious OSS work should still enter through MissionV1 runtime aliases such as
# mission-a3-kimi, mission-a3-deepseek, or mission-a2-flash.
#
# Start vLLM separately, then launch the bridge with:
#   set -a
#   . examples/vllm-runtime.env.example
#   set +a
#   python3 bridge.py

UPSTREAM_BASE=http://127.0.0.1:8000/v1
UPSTREAM_API_KEY=dummy

# Map runtime reasoning aliases to the vLLM served model name. Replace
# "Qwen/Qwen3.6-27B" with the exact --served-model-name used by your vLLM server.
MODEL_MAP_JSON={"ocg-kimi-k2.6":"Qwen/Qwen3.6-27B","ocg-deepseek-v4-pro":"Qwen/Qwen3.6-27B","ocg-deepseek-v4-flash":"Qwen/Qwen3.6-27B"}

# Keep runtime calls controlled. The MissionV1 loop uses JSON actions and sends
# tools=[] upstream; vLLM provider-native auto tool calling is not part of v1
# managed investigation acceptance.
GPT_MODEL_STRATEGY=error
UPSTREAM_STREAM=0
CONTINUATION_TOOLS=none
REQUEST_DEADLINE_SECONDS=90
